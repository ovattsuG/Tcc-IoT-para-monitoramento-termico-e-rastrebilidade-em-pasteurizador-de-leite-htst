      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Temperaturas",
          "links": [],
          "description": "SW-06: T1 (pasteurização) e T2 (saída), com a linha de 72 °C. Leitura inválida aparece como lacuna (SW-09).",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "fg3xub4ujtiwwf"
                      },
                      "spec": {
                        "dataset": "htst",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT timestamp_utc AS time, t1_c AS \"T1\", t2_c AS \"T2\"\nFROM leituras\nWHERE $__timeFilter(timestamp_utc)\nORDER BY 1"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.1",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "celsius",
                  "decimals": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 72,
                        "color": "red"
                      }
                    ]
                  },
