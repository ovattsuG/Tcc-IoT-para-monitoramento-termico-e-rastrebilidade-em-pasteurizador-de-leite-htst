      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Alarmes",
          "description": "SW-07: vermelho = SUBTEMP_SEM_DESVIO, PRESSAO ou FALHA_T1; amarelo = FALHA_T2, WDT ou FALHA_SD; azul = SUBTEMP (desvio correto).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "fg3xub4ujtiwwf"
                      },
                      "spec": {
                        "dataset": "htst",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT CASE\n  WHEN string_to_array(alarmes, '|') && ARRAY['SUBTEMP_SEM_DESVIO','PRESSAO','FALHA_T1'] THEN 3\n  WHEN string_to_array(alarmes, '|') && ARRAY['FALHA_T2','WDT','FALHA_SD'] THEN 2\n  WHEN alarmes <> '' THEN 1\n  ELSE 0 END AS nivel\nFROM leituras ORDER BY timestamp_utc DESC NULLS LAST LIMIT 1"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.1",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "/.*/"
                },
                "orientation": "auto",
                "textMode": "value",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "text"
                      }
                    ]
                  },
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "OK",
                          "color": "green",
                          "index": 0
                        },
