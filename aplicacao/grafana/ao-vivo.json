                    },
                    "axisBorderShow": true,
                    "axisPlacement": "auto",
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
